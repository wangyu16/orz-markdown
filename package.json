{
  "name": "orz-markdown",
  "version": "2.2.0",
  "description": "Markdown renderer and single-file, self-editing HTML document family with math, diagrams, themes, and source-aware copy.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./runtime": "./dist/runtime.js",
    "./preview-frame": "./dist/preview-frame.js",
    "./themes": "./dist/themes.js",
    "./themes/*": "./themes/*",
    "./doc-meta": "./dist/doc-meta.js",
    "./version": "./dist/version.js",
    "./carrier": "./dist/carrier.js",
    "./carrier/read": "./dist/carrier/read.js",
    "./carrier/shell": "./dist/carrier/shell/index.js",
    "./carrier/editor": "./dist/carrier/editor/index.js",
    "./carrier/app": "./dist/carrier/app/index.js",
    "./carrier/conformance": "./dist/carrier/conformance/index.js",
    "./carrier/node": "./dist/carrier/node/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "themes",
    "vendor",
    "orz-markdown-skills",
    "tests/carrier-corpus"
  ],
  "scripts": {
    "prebuild": "tsx scripts/sync-version.ts && tsx scripts/build-skill-template.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:starters": "tsx scripts/check-site-starters.ts",
    "check:site": "npm run check:starters && tsx scripts/check-site-discovery.ts",
    "visibility:baseline": "tsx scripts/visibility-baseline.ts",
    "render": "tsx scripts/render.ts",
    "render:minimal": "tsx scripts/render-minimal.ts",
    "prepublishOnly": "npm run build && npm run test",
    "build:web": "node build/web-bundle.mjs",
    "build:codemirror": "tsx scripts/build-codemirror.ts"
  },
  "keywords": [
    "markdown",
    "markdown-it",
    "parser",
    "plugin",
    "katex",
    "mermaid",
    "smiles",
    "qrcode",
    "toc",
    "footnote",
    "cjk",
    "copy-as-markdown"
  ],
  "author": "Yu Wang <yuwang@orz.how>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangyu16/orz-markdown.git"
  },
  "homepage": "https://markdown.orz.how/",
  "bugs": "https://github.com/wangyu16/orz-markdown/issues",
  "dependencies": {
    "@traptitech/markdown-it-katex": "^3.6.0",
    "@types/markdown-it": "^14.1.2",
    "katex": "0.16.47",
    "markdown-it": "^14.3.2",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-cjk-breaks": "^2.0.1",
    "markdown-it-container": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "node-emoji": "^2.2.0",
    "qrcode-svg": "^1.1.0"
  },
  "peerDependencies": {
    "playwright-core": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "@types/markdown-it-anchor": "^7.0.0",
    "@types/markdown-it-container": "^4.0.0",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/node": "^25.3.5",
    "@types/qrcode-svg": "^1.1.5",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.10.6",
    "playwright-core": "^1.62.1",
    "postcss": "^8.5.28",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.16"
  }
}
